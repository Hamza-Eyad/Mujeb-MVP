# Staging server: host-specific values for setup-asterisk.sh, firewall-sip.sh, trunk-check.sh and
# simulate-trunk-call.sh. Copy to /etc/mujeeb/asterisk-host.env (root:root 600). Never commit the real file:
# it holds this server's address, ExaCall's addresses and the DID. Plain KEY=value lines (read by bash).
# The addresses below are documentation placeholders (RFC 5737), not real hosts.

# ── This server ──────────────────────────────────────────────────────────
# The server's public IP: OCI's reserved IP, or the one Skyline's portal shows (the VM itself only has a private
# address, behind a 1:1 NAT). Asterisk advertises it in SIP and SDP (external_*_address).
PUBLIC_IP=203.0.113.10
# The private network, as `ip -4 addr` shows it (the VCN, or at least the VM's subnet): addresses inside it (and
# loopback) are not NATed.
LOCAL_NET=10.0.0.0/16
SIP_PORT=5060
RTP_START=10000
RTP_END=10199

# ── Inbound calls ────────────────────────────────────────────────────────
# echo   = hello-world then Echo(): checks the line without Mujeeb (stage 5).
# mujeeb = every inbound call goes to Mujeeb's gateway. Mujeeb refuses a DID with no route in routes.json, and the
#          caller hears the apology (one routing source: routes.json).
INBOUND_MODE=echo
# Where the dialed number (DID) is read. ruri = the Request-URI user (${EXTEN}); to = the user part of the To
# header (registration trunks often carry the account name in the Request-URI). Passed on exactly as read.
DID_SOURCE=ruri
# Seconds Asterisk waits for Mujeeb to answer: at least 2 s above MUJEEB_TELEPHONY_ANSWER_TIMEOUT_MS (7 s).
DIAL_TIMEOUT=10

# ── ExaCall trunk ────────────────────────────────────────────────────────
# no = no trunk endpoint at all (before ExaCall's details arrive): no request is identified as the carrier.
TRUNK_ENABLED=no
# ip = calls identified by their source address · registration = we register to TRUNK_HOST with credentials
TRUNK_AUTH=ip
# Comma-separated IPv4 addresses (or ranges). Signaling: identify + firewall (SIP). Media: firewall (RTP) only.
# Stage 3 simulation (SIPp on this host): TRUNK_ENABLED=yes and TRUNK_SIGNALING_IPS=127.0.0.1.
TRUNK_SIGNALING_IPS=
TRUNK_MEDIA_IPS=
# ExaCall's SIP host: the registration server, and the OPTIONS target when TRUNK_QUALIFY=yes.
TRUNK_HOST=
TRUNK_PORT=5060
# udp | tcp
TRUNK_TRANSPORT=udp
# Asterisk codec names, in order of preference.
TRUNK_CODECS=g722,alaw,ulaw
# yes only after ExaCall confirms their SBC answers OPTIONS: a carrier that ignores OPTIONS shows "Unavailable"
# while calls work.
TRUNK_QUALIFY=no
# Registration only: a root-only (600) file with TRUNK_USERNAME= and TRUNK_PASSWORD= lines. Not sourced: only those
# two values are read.
TRUNK_SECRETS_FILE=/etc/mujeeb/exacall-trunk.env

# ── Mujeeb's gateway (same host, loopback only) ──────────────────────────
GATEWAY_URI=ws://127.0.0.1:8790/media
GATEWAY_USERNAME=asterisk
