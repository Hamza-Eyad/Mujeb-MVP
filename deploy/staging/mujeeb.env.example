# Mujeeb on the staging server: copy to /etc/mujeeb/mujeeb.env (root:mujeeb 0640) with sudoedit. Never commit it.
# systemd reads it (EnvironmentFile): KEY=value lines, no quotes, no "export", comments on their own lines only.
# Full list of settings: .env.example at the repository root.
#
# Stages 1-6: fake providers and NO API key on the server, so no paid request is possible. Real keys arrive only in
# stage 7, after its own approval, and are separate staging keys with spending limits (plan 3-ج).

# ── Providers: fake until stage 7 ────────────────────────────────────────
MUJEEB_LLM_PROVIDER=fake
MUJEEB_STT_PROVIDER=fake
MUJEEB_TTS_PROVIDER=fake
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Stage 7 only (with the keys): MUJEEB_LLM_MODEL, MUJEEB_STT_MODEL, MUJEEB_TTS_MODEL, MUJEEB_TTS_VOICE_ID.

# ── Appointment tools: synthetic data only (DECISIONS A17) ───────────────
MUJEEB_SCHEDULING_PROVIDER=memory
MUJEEB_SCHEDULING_DATASET=config/test-data/demo-clinic.dataset.json
MUJEEB_AGENT_PROFILE=config/agents/demo-clinic

# ── Telephony gateway: loopback, Asterisk on the same host ───────────────
MUJEEB_TELEPHONY_HOST=127.0.0.1
MUJEEB_TELEPHONY_PORT=8790
MUJEEB_TELEPHONY_ROUTES=/etc/mujeeb/routes.json
# = ExaCall's channels
MUJEEB_TELEPHONY_MAX_CALLS=5
MUJEEB_TELEPHONY_USERNAME=asterisk
# The shared secret: sudo cat /etc/asterisk/mujeeb-telephony-password
MUJEEB_TELEPHONY_PASSWORD=
# Must stay at least 2 s below DIAL_TIMEOUT in asterisk-host.env (setup-asterisk.sh checks it).
MUJEEB_TELEPHONY_ANSWER_TIMEOUT_MS=7000
MUJEEB_TELEPHONY_HEALTH_LOG_MS=60000
MUJEEB_TELEPHONY_STATUS_PROBE_MS=0

# ── Logs: no transcripts, ever, on this server ───────────────────────────
MUJEEB_LOG_LEVEL=info
MUJEEB_LOG_DIR=/var/lib/mujeeb/logs
MUJEEB_LOG_TRANSCRIPTS=false
