# Shell scripts and Asterisk configs run inside Linux (WSL or a server): keep LF on every checkout,
# whatever core.autocrlf says, or bash fails on "\r".
*.sh text eol=lf
deploy/asterisk/** text eol=lf
# Prompt audio (raw PCM) is binary: no line-ending conversion.
deploy/asterisk/**/*.sln16 binary
# Windows launchers run in cmd.exe, which misreads LF-only batch files.
deploy/asterisk/**/*.cmd text eol=crlf
