# Mujeeb — local configuration. Copy to `.env` and fill in. Never commit `.env`.
# Phase 0 rule: never use real patient data with these providers.

# ── Secrets ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# ── LLM (OpenAI Responses API, store=false) ───────────────────────────────
MUJEEB_LLM_PROVIDER=openai
# Required. Pick a low-latency model available on your account.
MUJEEB_LLM_MODEL=
# Optional: only for reasoning models (none|minimal|low|medium|high). Lower = faster first token.
MUJEEB_LLM_REASONING_EFFORT=
MUJEEB_LLM_FIRST_TOKEN_TIMEOUT_MS=8000
# For reasoning models this budget also includes reasoning tokens.
MUJEEB_LLM_MAX_OUTPUT_TOKENS=300
# Budget for requests that offer tools: reasoning + function-call arguments + the spoken reply.
# A round that runs out of tokens is truncated and its tool calls are ignored, so keep headroom.
MUJEEB_LLM_MAX_OUTPUT_TOKENS_TOOLS=1024
# Resend `phase` on assistant history (OpenAI recommends it for GPT-5.3+ models). Set false for older models.
MUJEEB_LLM_ASSISTANT_PHASE=true

# ── Speech-to-text (ElevenLabs realtime) ──────────────────────────────────
MUJEEB_STT_PROVIDER=elevenlabs
# The realtime model id from the ElevenLabs API reference (at the time of writing: scribe_v2_realtime).
MUJEEB_STT_MODEL=scribe_v2_realtime
MUJEEB_STT_LANGUAGE=ar
# vad (default) | turn_prediction — enable turn_prediction only after `npm run probe:elevenlabs` shows it is applied.
MUJEEB_STT_COMMIT_STRATEGY=vad
# Silence (seconds) before a segment is committed. Lower = faster replies, higher = fewer split turns.
MUJEEB_STT_VAD_SILENCE_SECS=0.8
MUJEEB_STT_CHUNK_MS=100

# ── Text-to-speech (ElevenLabs multi-context WebSocket) ───────────────────
MUJEEB_TTS_PROVIDER=elevenlabs
# Required. Note: eleven_v3 is not supported by the multi-context WebSocket.
MUJEEB_TTS_MODEL=
# Default voice id from your ElevenLabs voice library. A clinic's profile.json can set
# its own "voiceId", which wins over this value. One of the two is required.
MUJEEB_TTS_VOICE_ID=
MUJEEB_TTS_FIRST_AUDIO_TIMEOUT_MS=5000

# ── ElevenLabs account ────────────────────────────────────────────────────
MUJEEB_ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# Zero Retention Mode is Enterprise-only. Verify with `npm run probe:elevenlabs` before relying on it.
MUJEEB_ELEVENLABS_ZERO_RETENTION=false

# ── Conversation behaviour ────────────────────────────────────────────────
# full = barge-in enabled · half = mic muted to STT while Mujeeb speaks (echo fallback, no barge-in)
MUJEEB_DUPLEX_MODE=full
MUJEEB_FALSE_INTERRUPTION_TIMEOUT_MS=1500
MUJEEB_ECHO_TAIL_MS=1200
# Pause before a confirmed write runs, so a caller who keeps talking ("yes… but") cancels it first.
MUJEEB_TOOL_CONFIRM_GRACE_MS=400

# ── Appointment tools (Phase 1) ───────────────────────────────────────────
# none = no tools (text-only agent) · memory = synthetic in-memory scheduling system (no network)
# medplum = Medplum sandbox project (temporary test HIS, synthetic data only — DECISIONS A15)
MUJEEB_SCHEDULING_PROVIDER=memory
# Synthetic data only (DECISIONS A17).
MUJEEB_SCHEDULING_DATASET=config/test-data/demo-clinic.dataset.json
MUJEEB_SCHEDULING_TIMEOUT_MS=4000
MUJEEB_SCHEDULING_WRITE_TIMEOUT_MS=8000
# How long the clinic directory (services, schedules, practitioners) is cached by the Medplum adapter.
MUJEEB_SCHEDULING_DIRECTORY_TTL_SEC=300

# ── Medplum sandbox (only when MUJEEB_SCHEDULING_PROVIDER=medplum, or for `npm run seed:medplum -- --apply`) ──
MUJEEB_MEDPLUM_BASE_URL=https://api.medplum.com/
# Client application credentials (client_credentials grant). Secrets: never commit.
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
# Identifier system under which patients' national ID / Iqama numbers are stored.
MUJEEB_MEDPLUM_NATIONAL_ID_SYSTEM=urn:mujeeb:identifier:national-id

# ── Telephony gateway (npm run telephony) ─────────────────────────────────
# Asterisk on the same host opens one WebSocket per call (chan_websocket). Loopback only.
# PASSWORD is the shared secret Asterisk sends (websocket_client.conf username/password). Required for telephony.
MUJEEB_TELEPHONY_HOST=127.0.0.1
MUJEEB_TELEPHONY_PORT=8790
MUJEEB_TELEPHONY_ROUTES=config/telephony/routes.json
MUJEEB_TELEPHONY_MAX_CALLS=5
MUJEEB_TELEPHONY_USERNAME=asterisk
MUJEEB_TELEPHONY_PASSWORD=
MUJEEB_TELEPHONY_CALL_START_TIMEOUT_MS=3000

# ── Local dev server / profile / logs ─────────────────────────────────────
MUJEEB_AGENT_PROFILE=config/agents/demo-clinic
MUJEEB_DEV_HOST=127.0.0.1
MUJEEB_DEV_PORT=8787
MUJEEB_LOG_LEVEL=info
MUJEEB_LOG_DIR=logs
# Keep false: transcripts are not written to logs/metrics unless explicitly enabled.
MUJEEB_LOG_TRANSCRIPTS=false
